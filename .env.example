# ==========================================
# REQUIRED FOR VERCEL DEPLOYMENT
# ==========================================
# Use a free PostgreSQL database from Neon (https://neon.tech) or Supabase (https://supabase.com)
# Example Neon connection string:
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# JWT secret for signing auth tokens - use a long random string in production
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# App URL - set to your Vercel deployment URL
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Google Gemini AI API key from https://aistudio.google.com
AI_API_KEY="your-google-gemini-api-key"
